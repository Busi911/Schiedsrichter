# Neon Postgres — reguläre App-Rolle (app_user, OHNE BYPASSRLS -> RLS greift wirklich).
# Wird nach Migration 0002 per ALTER ROLE app_user WITH PASSWORD '...' vergeben.
DATABASE_URL="postgres://app_user:password@ep-xxxx.eu-central-1.aws.neon.tech/funktionstraegerhub?sslmode=require"

# Privilegierte Rolle (Neon-Owner-Rolle, hat BYPASSRLS) — NUR für Migrationen
# (drizzle-kit) und den Cron-Job (src/db/admin.ts), der bewusst
# vereinsübergreifend lesen muss. Niemals für normalen App-Traffic verwenden.
DATABASE_ADMIN_URL="postgres://owner:password@ep-xxxx.eu-central-1.aws.neon.tech/funktionstraegerhub?sslmode=require"

# Auth.js — Secret zum Signieren von Sessions/Cookies (z.B. `openssl rand -base64 32`)
AUTH_SECRET=""

# Schützt /setup (einmaliges Anlegen des ersten Vereins + Admins).
# Nach dem Bootstrap entfernen bzw. leer lassen, um die Route zu deaktivieren.
SETUP_SECRET=""

# Schützt den täglichen ICS-Sync-Cron-Endpoint (/api/cron/ics-sync).
# Vercel sendet diesen Wert automatisch als "Authorization: Bearer ..."
# Header mit, sobald die Env-Variable im Projekt gesetzt ist.
CRON_SECRET=""

# SMTP — für den Magic-Link-Login (Auth.js Nodemailer-Provider) und Terminerinnerungen
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Handballpate <no-reply@example.org>"

# Web-Push-Erinnerungen (siehe src/lib/push.ts) — zusätzlich zur E-Mail,
# best effort. Ohne diese drei Werte bleibt Push einfach inaktiv.
# Erzeugen mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto:-Adresse oder https://-URL, mit der Push-Dienste den Absender
# kontaktieren können (Pflichtfeld des Web-Push-Protokolls).
VAPID_SUBJECT="mailto:admin@example.org"
# Identischer Wert wie VAPID_PUBLIC_KEY, aber NEXT_PUBLIC_-Präfix, damit der
# Browser (src/components/push-anmelden.tsx) ihn zum Abonnieren lesen kann —
# der Public Key ist wie der Name sagt unkritisch, kein Secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
